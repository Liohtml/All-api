{
  "name": "trustpilot",
  "displayName": "Trustpilot",
  "baseUrl": "https://www.trustpilot.com",
  "description": "Trustpilot company reviews, logged out: find a business, its rating summary and topics, and its reviews page by page (all, or one star rating).",
  "operations": [
    {
      "name": "searchBusinesses",
      "description": "Find businesses on Trustpilot by name or domain words: the top 5 of the site's own search, with businessUnitId, name, domain (the {domain} that reviews and business take), numberOfReviews, trustScore, stars, country, city, categories, websiteUrl.",
      "request": {
        "method": "GET",
        "url": "https://www.trustpilot.com/api/consumersitesearch-api/businessunits/search?country=US&page=1&pageSize=5&query=%7Bquery%7D",
        "headers": {
          "referer": "https://www.trustpilot.com/search?query={query}",
          "accept-language": "en-US,en;q=0.9",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "query",
          "at": [
            "query:query"
          ]
        },
        {
          "param": "query",
          "at": [
            "header:referer"
          ],
          "template": "https://www.trustpilot.com/search?query={query}"
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.trustpilot.com/search?query={query}"
      },
      "match": {
        "method": "GET",
        "host": "www.trustpilot.com",
        "path": "/api/consumersitesearch-api/businessunits/search"
      },
      "response": {
        "format": "json",
        "contentType": "application/json; charset=utf-8",
        "extract": "businessUnits",
        "pick": [
          "businessUnitId",
          "name=displayName",
          "domain=identifyingName",
          "numberOfReviews",
          "trustScore=score.trustScore",
          "stars=score.stars",
          "country=countryCode",
          "city=address.city",
          "categories=categories[*].name",
          "websiteUrl"
        ]
      },
      "params": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "business name or domain words",
          "example": "metzler"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "learnedAt": "2026-10-11T07:28:21.638Z"
    },
    {
      "name": "business",
      "description": "A business's Trustpilot summary: businessUnitId (for topics), name, domain, numberOfReviews, trustScore, stars, websiteUrl, country, categories, isClaimed, replyPercentage, ratings (count per star), languages (review count per language), reviewPages.",
      "request": {
        "method": "GET",
        "url": "https://www.trustpilot.com/review/%7Bdomain%7D?languages=all",
        "headers": {
          "accept-language": "en-US,en;q=0.9",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36",
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
          "priority": "u=0, i",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "none",
          "sec-fetch-user": "?1"
        }
      },
      "slots": [
        {
          "param": "domain",
          "at": [
            "path:1"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.trustpilot.com/review/{domain}?languages=all"
      },
      "match": {
        "method": "GET",
        "host": "www.trustpilot.com",
        "path": "/review/*"
      },
      "response": {
        "format": "embedded",
        "contentType": "text/html; charset=utf-8",
        "extract": "props.pageProps",
        "pick": [
          "businessUnitId=businessUnit.id",
          "name=businessUnit.displayName",
          "domain=businessUnit.identifyingName",
          "numberOfReviews=businessUnit.numberOfReviews",
          "trustScore=businessUnit.trustScore",
          "stars=businessUnit.stars",
          "websiteUrl=businessUnit.websiteUrl",
          "country=businessUnit.countryCode",
          "categories=businessUnit.categories[*].name",
          "isClaimed=businessUnit.isClaimed",
          "replyPercentage=businessUnit.activity.replyBehavior.replyPercentage",
          "ratings=filters.reviewStatistics.ratings",
          "languages=filters.reviewStatistics.reviewLanguages",
          "reviewPages=filters.pagination.totalPages"
        ],
        "embedded": {
          "regex": "id=\"__NEXT_DATA__\"[^>]*>\\s*([\\[{])"
        }
      },
      "params": [
        {
          "name": "domain",
          "type": "string",
          "required": true,
          "description": "the business's Trustpilot domain, as in trustpilot.com/review/<domain>; searchBusinesses returns it as domain",
          "example": "metzlergmbh.de",
          "pattern": "[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+",
          "hint": "a domain such as metzlergmbh.de or www.amazon.com (no https://, no path)"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "learnedAt": "2026-10-11T07:27:09.968Z"
    },
